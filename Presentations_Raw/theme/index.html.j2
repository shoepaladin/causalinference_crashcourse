{#-
  Custom reveal.js slide template for the Causal Inference Crash Course.
  Extends nbconvert's built-in `reveal` template and:
    * injects the custom.css design system (wins over the reveal theme),
    * drops the requirejs / jquery / mermaid CDN loaders,
    * loads reveal.js, the notes plugin, and MathJax 3 via marker comments
      that build_slides.py replaces with the vendored, inlined asset contents
      so the exported HTML is fully self-contained and works offline.
-#}
{%- extends 'reveal/index.html.j2' -%}

{# Remove the jquery / requirejs / mermaid CDN <script> tags from <head>. #}
{% block html_head_js %}

{# ---- Attribution: schema.org JSON-LD + Highwire meta + canonical link. ----
   Lives in the template, not the generated HTML, so a rebuild can't wipe it.
   Author comes from the notebook's own metadata.authors when set. #}
{%- set _author = (nb.metadata.get('authors') or [{'name': 'Julian Hsu'}])[0].get('name', 'Julian Hsu') -%}
{%- set _title = resources.get('metadata', {}).get('name', 'Causal Inference Crash Course') -%}
<meta name="author" content="{{ _author }}">
<link rel="canonical" href="https://github.com/shoepaladin/causalinference_crashcourse">
<meta name="citation_author" content="{{ _author }}">
<meta name="citation_title" content="{{ _title }}">
<meta name="citation_publication_date" content="2026">
<meta name="citation_pdf_url" content="https://github.com/shoepaladin/causalinference_crashcourse/blob/main/Presentations_Raw/Updated_v2/{{ _title }}.pdf">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "headline": "{{ _title }}",
  "name": "{{ _title }}",
  "isPartOf": "Causal Inference Crash Course",
  "author": {"@type": "Person", "name": "{{ _author }}", "email": "hsu.julian.econ@gmail.com"},
  "datePublished": "2026",
  "url": "https://github.com/shoepaladin/causalinference_crashcourse"
}
</script>
{% endblock html_head_js %}

{# MathJax 3 (SVG output => no external font files => offline-safe). #}
{% block html_head_js_mathjax %}
<script>
window.MathJax = {
  tex: {
    inlineMath: [['$', '$'], ['\\(', '\\)']],
    displayMath: [['$$', '$$'], ['\\[', '\\]']],
    processEscapes: true
  },
  svg: { fontCache: 'global', scale: 1.05 },
  options: { skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'] }
};
</script>
<!--__MATHJAX_JS__-->
{% endblock html_head_js_mathjax %}

{# custom.css is injected by build_slides.py *after* the reveal theme <link>
   (which nbconvert emits outside the head block) so our rules always win. #}
{% block html_head_css %}
{% endblock html_head_css %}

{# Plain reveal.js init (no requirejs). Assets inlined by build_slides.py. #}
{% block footer_js %}
<!--__REVEAL_JS__-->
<!--__NOTES_JS__-->
<script>
  Reveal.initialize({
    controls: true,
    progress: true,
    hash: true,
    center: false,
    transition: "{{ resources.reveal.transition | default('slide', true) }}",
    slideNumber: "c/t",
    width: {{ resources.reveal.width | default(1150, true) }},
    height: {{ resources.reveal.height | default(740, true) }},
    margin: 0.06,
    minScale: 0.2,
    maxScale: 1.8,
    plugins: [RevealNotes]
  });
</script>
{% endblock footer_js %}
